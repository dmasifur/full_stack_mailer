    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
