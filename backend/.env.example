# Copy to .env and fill in. Values are read verbatim — do not use expressions
# (e.g. "10 * 1024 * 1024"), quotes around numbers, or trailing comments.

APP_NAME=Full Stack Mailer
# Anything other than "development" is treated as production: the session cookie
# becomes Secure, and /health stops disclosing driver errors.
APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/full_stack_mailer

# Use rediss:// for TLS. Certificate verification is controlled by
# REDIS_SSL_CERT_REQS below and only applies to rediss:// URLs.
REDIS_URL=redis://localhost:6379/0

# --- Microsoft OAuth -------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" for multi-tenant apps, or a tenant GUID for single-tenant.
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# --- Secrets ---------------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session lifetime in seconds. 28800 = 8 hours.
ACCESS_TOKEN_TTL_SECONDS=28800

# --- Web -------------------------------------------------------------------
# Comma-separated CORS origins. "*" is rejected at startup because credentials
# are enabled.
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:5173

# Where to send the browser after a successful OAuth login. Leave empty to have
# the callback return JSON instead of redirecting.
FRONTEND_URL=

# Max CSV upload size in bytes. 10485760 = 10 MB.
MAX_UPLOAD_BYTES=10485760

# Redis TLS certificate verification: required | optional | none.
# Leave as "required" unless your provider uses a private CA.
REDIS_SSL_CERT_REQS=required

# --- Cloudflare R2 (template HTML storage) ---------------------------------
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mailer-templates
